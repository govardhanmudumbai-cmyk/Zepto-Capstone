import os
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
import joblib

from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.impute import SimpleImputer

from sklearn.linear_model import LogisticRegression, LinearRegression
from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.ensemble import RandomForestClassifier

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    roc_curve,
    roc_auc_score,
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

from imblearn.over_sampling import SMOTE
from imblearn.pipeline import Pipeline as ImbPipeline

pd.set_option("display.max_columns", None)
pd.set_option("display.width", 160)

os.makedirs("outputs", exist_ok=True)
os.makedirs("model_artifacts", exist_ok=True)


# ============================================================
# STEP 1 — LOAD CLEANED TITANIC DATA
# ============================================================

print("=" * 80)
print("STEP 1 — LOADING CLEANED TITANIC DATA")
print("=" * 80)

if not os.path.exists("titanic.csv"):
    raise FileNotFoundError(
        "titanic.csv not found. Upload titanic.csv to Colab first."
    )

df = pd.read_csv("titanic.csv")

print("Dataset shape:", df.shape)
print("Columns:")
print(df.columns.tolist())

display(df.head())


# ============================================================
# STEP 2 — CLASS BALANCE
# ============================================================

print("\n" + "=" * 80)
print("STEP 2 — CLASS BALANCE")
print("=" * 80)

class_counts = df["survived"].value_counts().sort_index()
class_percent = (
    df["survived"]
    .value_counts(normalize=True)
    .sort_index() * 100
)

class_balance = pd.DataFrame({
    "Class": [
        "Not Survived (0)",
        "Survived (1)"
    ],
    "Count": class_counts.values,
    "Percentage": class_percent.round(2).values
})

display(class_balance)

print(
    "Stratification is used because the survival classes are not "
    "perfectly balanced. It preserves approximately the same class "
    "proportions in both training and testing data."
)


# ============================================================
# STEP 3 — STRATIFIED TRAIN / TEST SPLIT
# ============================================================

print("\n" + "=" * 80)
print("STEP 3 — STRATIFIED TRAIN / TEST SPLIT")
print("=" * 80)

X = df.drop(columns=["survived"])
y = df["survived"]

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("Training shape:", X_train.shape)
print("Testing shape:", X_test.shape)

print("\nOriginal class proportions:")
display(y.value_counts(normalize=True).sort_index())

print("\nTraining class proportions:")
display(y_train.value_counts(normalize=True).sort_index())

print("\nTesting class proportions:")
display(y_test.value_counts(normalize=True).sort_index())


# ============================================================
# STEP 4 — MODEL FEATURES
# ============================================================

print("\n" + "=" * 80)
print("STEP 4 — MODEL FEATURES")
print("=" * 80)

numeric_features = [
    "pclass",
    "age",
    "sibsp",
    "parch",
    "fare"
]

categorical_features = [
    "sex",
    "embarked"
]

model_features = (
    numeric_features +
    categorical_features
)

X_train_model = X_train[model_features].copy()
X_test_model = X_test[model_features].copy()

print("Numeric features:")
print(numeric_features)

print("\nCategorical features:")
print(categorical_features)

print(
    "\nRedundant/leaky fields such as alive, class, adult_male, "
    "alone and embark_town are excluded."
)


# ============================================================
# STEP 5 — PREPROCESSING
# ============================================================

print("\n" + "=" * 80)
print("STEP 5 — PREPROCESSING")
print("=" * 80)

numeric_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="median")
    ),
    (
        "scaler",
        StandardScaler()
    )
])

categorical_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(strategy="most_frequent")
    ),
    (
        "encoder",
        OneHotEncoder(
            handle_unknown="ignore",
            sparse_output=False
        )
    )
])

preprocessor = ColumnTransformer([
    (
        "numeric",
        numeric_pipeline,
        numeric_features
    ),
    (
        "categorical",
        categorical_pipeline,
        categorical_features
    )
])

print("Numeric:")
print("  Median imputation -> StandardScaler")

print("\nCategorical:")
print("  Most-frequent imputation -> OneHotEncoder")

print(
    "\nAll preprocessing is contained inside the model Pipeline, "
    "so it is fitted only on the training split."
)


# ============================================================
# STEP 6 — TRAIN THREE CLASSIFIERS
# ============================================================

print("\n" + "=" * 80)
print("STEP 6 — TRAIN THREE CLASSIFIERS")
print("=" * 80)

models = {

    "Logistic Regression":
        LogisticRegression(
            max_iter=1000,
            random_state=42
        ),

    "Decision Tree":
        DecisionTreeClassifier(
            max_depth=5,
            random_state=42
        ),

    "Random Forest":
        RandomForestClassifier(
            n_estimators=200,
            random_state=42
        )
}

fitted_models = {}
predictions = {}
probabilities = {}

for name, model in models.items():

    pipeline = Pipeline([
        (
            "preprocessor",
            preprocessor
        ),
        (
            "model",
            model
        )
    ])

    pipeline.fit(
        X_train_model,
        y_train
    )

    fitted_models[name] = pipeline

    predictions[name] = pipeline.predict(
        X_test_model
    )

    probabilities[name] = pipeline.predict_proba(
        X_test_model
    )[:, 1]

    print("✓", name, "trained")


# ============================================================
# STEP 7 — EVALUATION METRICS
# ============================================================

print("\n" + "=" * 80)
print("STEP 7 — CLASSIFICATION METRICS")
print("=" * 80)

classification_results = []

for name in models.keys():

    y_pred = predictions[name]
    y_prob = probabilities[name]

    classification_results.append({

        "Model": name,

        "Accuracy":
            accuracy_score(
                y_test,
                y_pred
            ),

        "Precision":
            precision_score(
                y_test,
                y_pred
            ),

        "Recall":
            recall_score(
                y_test,
                y_pred
            ),

        "F1":
            f1_score(
                y_test,
                y_pred
            ),

        "AUC":
            roc_auc_score(
                y_test,
                y_prob
            )
    })

classification_results_df = pd.DataFrame(
    classification_results
)

display(
    classification_results_df.round(4)
)

classification_results_df.to_csv(
    "outputs/classification_results.csv",
    index=False
)


# ============================================================
# STEP 8 — CONFUSION MATRICES + ROC
# ============================================================

print("\n" + "=" * 80)
print("STEP 8 — CONFUSION MATRICES AND ROC")
print("=" * 80)

fig, axes = plt.subplots(
    1,
    3,
    figsize=(18, 5)
)

for ax, name in zip(
    axes,
    models.keys()
):

    cm = confusion_matrix(
        y_test,
        predictions[name]
    )

    sns.heatmap(
        cm,
        annot=True,
        fmt="d",
        cmap="Blues",
        cbar=False,
        ax=ax
    )

    ax.set_title(name)
    ax.set_xlabel("Predicted")
    ax.set_ylabel("Actual")

plt.suptitle(
    "Confusion Matrices",
    fontsize=16
)

plt.tight_layout()
plt.show()


# ROC curves

plt.figure(figsize=(10, 7))

for name in models.keys():

    fpr, tpr, _ = roc_curve(
        y_test,
        probabilities[name]
    )

    auc_value = roc_auc_score(
        y_test,
        probabilities[name]
    )

    plt.plot(
        fpr,
        tpr,
        linewidth=2,
        label=f"{name} (AUC={auc_value:.3f})"
    )

plt.plot(
    [0, 1],
    [0, 1],
    "k--",
    label="Random"
)

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("ROC Curves")
plt.legend()
plt.grid(alpha=0.3)
plt.show()


# ============================================================
# STEP 9 — DECISION TREE VISUALIZATION
# ============================================================

print("\n" + "=" * 80)
print("STEP 9 — DECISION TREE VISUALIZATION")
print("=" * 80)

tree_pipeline = fitted_models[
    "Decision Tree"
]

tree_model = tree_pipeline.named_steps[
    "model"
]

feature_names = (
    tree_pipeline
    .named_steps["preprocessor"]
    .get_feature_names_out()
)

plt.figure(
    figsize=(25, 14)
)

plot_tree(
    tree_model,
    feature_names=feature_names,
    class_names=[
        "Not Survived",
        "Survived"
    ],
    filled=True,
    rounded=True,
    fontsize=8
)

plt.title(
    "Decision Tree Classifier",
    fontsize=16
)

plt.show()


# ============================================================
# STEP 10 — IMBALANCE COMPARISON
# ============================================================

print("\n" + "=" * 80)
print("STEP 10 — IMBALANCE COMPARISON")
print("=" * 80)


# ---------- BASELINE ----------

baseline_pipeline = Pipeline([
    (
        "preprocessor",
        preprocessor
    ),
    (
        "model",
        LogisticRegression(
            max_iter=1000,
            random_state=42
        )
    )
])

baseline_pipeline.fit(
    X_train_model,
    y_train
)

baseline_pred = baseline_pipeline.predict(
    X_test_model
)


# ---------- CLASS WEIGHT ----------

balanced_pipeline = Pipeline([
    (
        "preprocessor",
        preprocessor
    ),
    (
        "model",
        LogisticRegression(
            max_iter=1000,
            class_weight="balanced",
            random_state=42
        )
    )
])

balanced_pipeline.fit(
    X_train_model,
    y_train
)

balanced_pred = balanced_pipeline.predict(
    X_test_model
)


# ---------- SMOTE ----------

smote_pipeline = ImbPipeline([
    (
        "preprocessor",
        preprocessor
    ),
    (
        "smote",
        SMOTE(
            random_state=42
        )
    ),
    (
        "model",
        LogisticRegression(
            max_iter=1000,
            random_state=42
        )
    )
])

smote_pipeline.fit(
    X_train_model,
    y_train
)

smote_pred = smote_pipeline.predict(
    X_test_model
)


# ---------- COMPARE ----------

imbalance_results = []

for strategy, pred in [

    ("Baseline", baseline_pred),

    (
        "Class Weight Balanced",
        balanced_pred
    ),

    ("SMOTE", smote_pred)
]:

    imbalance_results.append({

        "Strategy": strategy,

        "Precision":
            precision_score(
                y_test,
                pred
            ),

        "Recall":
            recall_score(
                y_test,
                pred
            ),

        "F1":
            f1_score(
                y_test,
                pred
            )
    })

imbalance_results_df = pd.DataFrame(
    imbalance_results
)

display(
    imbalance_results_df.round(4)
)

imbalance_results_df.to_csv(
    "outputs/imbalance_comparison.csv",
    index=False
)

best_imbalance = (
    imbalance_results_df
    .sort_values(
        "F1",
        ascending=False
    )
    .iloc[0]
)

print(
    "\nBest imbalance strategy by F1:",
    best_imbalance["Strategy"]
)


# ============================================================
# STEP 11 — RANDOM FOREST GRIDSEARCH + OOB
# ============================================================

print("\n" + "=" * 80)
print("STEP 11 — RANDOM FOREST GRIDSEARCH")
print("=" * 80)

rf_pipeline = Pipeline([
    (
        "preprocessor",
        preprocessor
    ),
    (
        "model",
        RandomForestClassifier(
            oob_score=True,
            random_state=42
        )
    )
])

param_grid = {

    "model__n_estimators": [
        100,
        200
    ],

    "model__max_depth": [
        None,
        5,
        10
    ],

    "model__max_features": [
        "sqrt",
        "log2"
    ]
}

print("Running GridSearchCV...")

grid_search = GridSearchCV(
    estimator=rf_pipeline,
    param_grid=param_grid,
    cv=5,
    scoring="f1",
    n_jobs=-1
)

grid_search.fit(
    X_train_model,
    y_train
)

print("\nBest parameters:")
print(grid_search.best_params_)

print(
    "\nBest CV F1:",
    round(
        grid_search.best_score_,
        4
    )
)

best_rf_pipeline = (
    grid_search.best_estimator_
)

best_rf_model = (
    best_rf_pipeline
    .named_steps["model"]
)

print(
    "\nOOB score:",
    round(
        best_rf_model.oob_score_,
        4
    )
)

# IMPORTANT:
# best_params_ has ONE underscore at the end.

gridsearch_results = pd.DataFrame([
    {

        **grid_search.best_params_,

        "best_cv_f1":
            grid_search.best_score_,

        "oob_score":
            best_rf_model.oob_score_
    }
])

display(
    gridsearch_results.round(4)
)

gridsearch_results.to_csv(
    "outputs/gridsearch_best_params.csv",
    index=False
)


# ============================================================
# STEP 12 — REGRESSION: PREDICT FARE
# ============================================================

print("\n" + "=" * 80)
print("STEP 12 — LINEAR REGRESSION")
print("=" * 80)

regression_numeric = [
    "survived",
    "pclass",
    "age",
    "sibsp",
    "parch"
]

regression_categorical = [
    "sex",
    "embarked"
]

regression_features = (
    regression_numeric +
    regression_categorical
)

X_reg = df[
    regression_features
].copy()

y_reg = df[
    "fare"
].copy()

X_reg_train, X_reg_test, y_reg_train, y_reg_test = train_test_split(
    X_reg,
    y_reg,
    test_size=0.20,
    random_state=42
)

reg_numeric_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(
            strategy="median"
        )
    ),
    (
        "scaler",
        StandardScaler()
    )
])

reg_categorical_pipeline = Pipeline([
    (
        "imputer",
        SimpleImputer(
            strategy="most_frequent"
        )
    ),
    (
        "encoder",
        OneHotEncoder(
            handle_unknown="ignore",
            sparse_output=False
        )
    )
])

reg_preprocessor = ColumnTransformer([
    (
        "numeric",
        reg_numeric_pipeline,
        regression_numeric
    ),
    (
        "categorical",
        reg_categorical_pipeline,
        regression_categorical
    )
])

regression_pipeline = Pipeline([
    (
        "preprocessor",
        reg_preprocessor
    ),
    (
        "model",
        LinearRegression()
    )
])

regression_pipeline.fit(
    X_reg_train,
    y_reg_train
)

fare_pred = regression_pipeline.predict(
    X_reg_test
)

print(
    "Linear regression trained successfully."
)


# ============================================================
# STEP 13 — REGRESSION METRICS
# ============================================================

print("\n" + "=" * 80)
print("STEP 13 — REGRESSION METRICS")
print("=" * 80)

mae = mean_absolute_error(
    y_reg_test,
    fare_pred
)

rmse = np.sqrt(
    mean_squared_error(
        y_reg_test,
        fare_pred
    )
)

r2 = r2_score(
    y_reg_test,
    fare_pred
)

X_reg_train_transformed = (
    regression_pipeline
    .named_steps["preprocessor"]
    .transform(X_reg_train)
)

p = X_reg_train_transformed.shape[1]

n = len(y_reg_test)

adjusted_r2 = (
    1
    -
    (
        (1 - r2)
        *
        (n - 1)
        /
        (n - p - 1)
    )
)

regression_results_df = pd.DataFrame({

    "Metric": [
        "MAE",
        "RMSE",
        "R2",
        "Adjusted R2"
    ],

    "Value": [
        mae,
        rmse,
        r2,
        adjusted_r2
    ]
})

display(
    regression_results_df.round(4)
)

regression_results_df.to_csv(
    "outputs/regression_results.csv",
    index=False
)


# ============================================================
# STEP 14 — RESIDUAL PLOT
# ============================================================

print("\n" + "=" * 80)
print("STEP 14 — RESIDUAL ANALYSIS")
print("=" * 80)

residuals = (
    y_reg_test.values -
    fare_pred
)

plt.figure(
    figsize=(10, 6)
)

sns.scatterplot(
    x=fare_pred,
    y=residuals,
    alpha=0.7
)

plt.axhline(
    0,
    color="red",
    linestyle="--",
    linewidth=2
)

plt.xlabel("Predicted Fare")
plt.ylabel("Residual")
plt.title(
    "Residual Plot — Fare Regression"
)

plt.grid(alpha=0.3)

plt.show()

abs_residual_correlation = np.corrcoef(
    fare_pred,
    np.abs(residuals)
)[0, 1]

print(
    "Correlation between predicted fare "
    "and absolute residuals:",
    round(
        abs_residual_correlation,
        4
    )
)

if abs(abs_residual_correlation) > 0.30:

    hetero_conclusion = (
        "The residual plot provides evidence of "
        "heteroscedasticity because the magnitude "
        "of residuals changes noticeably with "
        "predicted fare."
    )

else:

    hetero_conclusion = (
        "The residual plot does not provide strong "
        "evidence of heteroscedasticity based on "
        "the residual-spread diagnostic."
    )

print("\nHeteroscedasticity conclusion:")
print(hetero_conclusion)


# ============================================================
# STEP 15 — MODEL COMPARISON
# ============================================================

print("\n" + "=" * 80)
print("STEP 15 — FINAL MODEL COMPARISON")
print("=" * 80)

best_classifier_row = (
    classification_results_df
    .sort_values(
        "F1",
        ascending=False
    )
    .iloc[0]
)

best_classifier_name = (
    best_classifier_row["Model"]
)

print(
    "Best classifier based on F1:",
    best_classifier_name
)

best_accuracy = (
    best_classifier_row["Accuracy"]
)

best_precision = (
    best_classifier_row["Precision"]
)

best_recall = (
    best_classifier_row["Recall"]
)

best_f1 = (
    best_classifier_row["F1"]
)

best_auc = (
    best_classifier_row["AUC"]
)


print("\nCLASSIFICATION MODELS")

display(
    classification_results_df.round(4)
)


print("\nREGRESSION MODEL")

regression_table = pd.DataFrame({

    "Regression Model": [
        "Linear Regression"
    ],

    "MAE": [mae],

    "RMSE": [rmse],

    "R2": [r2],

    "Adjusted R2": [
        adjusted_r2
    ]
})

display(
    regression_table.round(4)
)


# Separate metric groups

final_comparison = pd.DataFrame({

    "Model Type": [
        "Classification",
        "Classification",
        "Classification",
        "Regression"
    ],

    "Model": [
        "Logistic Regression",
        "Decision Tree",
        "Random Forest",
        "Linear Regression"
    ],

    "Accuracy": [
        classification_results_df.loc[
            classification_results_df["Model"]
            == "Logistic Regression",
            "Accuracy"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Decision Tree",
            "Accuracy"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Random Forest",
            "Accuracy"
        ].iloc[0],

        np.nan
    ],

    "Precision": [
        classification_results_df.loc[
            classification_results_df["Model"]
            == "Logistic Regression",
            "Precision"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Decision Tree",
            "Precision"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Random Forest",
            "Precision"
        ].iloc[0],

        np.nan
    ],

    "Recall": [
        classification_results_df.loc[
            classification_results_df["Model"]
            == "Logistic Regression",
            "Recall"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Decision Tree",
            "Recall"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Random Forest",
            "Recall"
        ].iloc[0],

        np.nan
    ],

    "F1": [
        classification_results_df.loc[
            classification_results_df["Model"]
            == "Logistic Regression",
            "F1"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Decision Tree",
            "F1"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Random Forest",
            "F1"
        ].iloc[0],

        np.nan
    ],

    "AUC": [
        classification_results_df.loc[
            classification_results_df["Model"]
            == "Logistic Regression",
            "AUC"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Decision Tree",
            "AUC"
        ].iloc[0],

        classification_results_df.loc[
            classification_results_df["Model"]
            == "Random Forest",
            "AUC"
        ].iloc[0],

        np.nan
    ],

    "MAE": [
        np.nan,
        np.nan,
        np.nan,
        mae
    ],

    "RMSE": [
        np.nan,
        np.nan,
        np.nan,
        rmse
    ],

    "R2": [
        np.nan,
        np.nan,
        np.nan,
        r2
    ],

    "Adjusted R2": [
        np.nan,
        np.nan,
        np.nan,
        adjusted_r2
    ]
})

display(
    final_comparison.round(4)
)

final_comparison.to_csv(
    "outputs/model_comparison.csv",
    index=False
)


# ---------- FINAL RECOMMENDATION ----------

