# ============================================================
# MISSING-VALUE HANDLING
# ============================================================

df_clean = df.copy()

# Store the measured percentages for documentation
missing_pct_original = (
    df.isnull().mean() * 100
).round(2)

print("Missing-value percentages before cleaning:")
display(
    missing_pct_original[
        missing_pct_original > 0
    ].sort_values(ascending=False)
)

# ------------------------------------------------------------
# 1. DECK
# ------------------------------------------------------------
# Very high missingness makes reliable imputation inappropriate.
# We drop the column rather than inventing a large amount of data.

df_clean = df_clean.drop(columns=["deck"])

# ------------------------------------------------------------
# 2. AGE
# ------------------------------------------------------------
# Missingness is between 5% and 30%.
# Median imputation is therefore used.

age_median = df_clean["age"].median()
df_clean["age"] = df_clean["age"].fillna(age_median)

# ------------------------------------------------------------
# 3. EMBARKED + EMBARK_TOWN
# ------------------------------------------------------------
# Missingness is below 5%, so rows containing missing values
# are dropped according to the assignment rule.

df_clean = df_clean.dropna(
    subset=["embarked", "embark_town"]
)

# ------------------------------------------------------------
# VERIFY CLEANING
# ------------------------------------------------------------

print("\nShape before cleaning:", df.shape)
print("Shape after cleaning:", df_clean.shape)

print("\nRemaining missing values:")
display(
    df_clean.isnull().sum()[
        df_clean.isnull().sum() > 0
    ]
)

print("\nCleaning complete.")
# Save the cleaned Titanic dataset.
