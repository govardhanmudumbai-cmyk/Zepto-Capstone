fare_mean = df_clean["fare"].mean()
fare_median = df_clean["fare"].median()
fare_mode = df_clean["fare"].mode().iloc[0]

print("\nFARE STATISTICS")
print("Mean:", round(fare_mean, 2))
print("Median:", round(fare_median, 2))
print("Mode:", round(fare_mode, 2))

if fare_mean > fare_median > fare_mode:
    skew_conclusion = "right-skewed"
elif fare_mean < fare_median < fare_mode:
    skew_conclusion = "left-skewed"
else:
    skew_conclusion = "approximately symmetric / mixed"

print("Distribution:", skew_conclusion)
