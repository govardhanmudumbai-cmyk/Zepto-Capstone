# ============================================================
# IQR OUTLIER ANALYSIS
# ============================================================

def iqr_outlier_report(series):
    q1 = series.quantile(0.25)
    q3 = series.quantile(0.75)

    iqr = q3 - q1

    lower = q1 - 1.5 * iqr
    upper = q3 + 1.5 * iqr

    outliers = series[
        (series < lower) | (series > upper)
    ]

    return {
        "Q1": q1,
        "Q3": q3,
        "IQR": iqr,
        "lower_bound": lower,
        "upper_bound": upper,
        "outlier_count": len(outliers)
    }


age_outliers = iqr_outlier_report(df_clean["age"])
fare_outliers = iqr_outlier_report(df_clean["fare"])

print("AGE OUTLIERS")
print(age_outliers)

print("\nFARE OUTLIERS")
print(fare_outliers)


